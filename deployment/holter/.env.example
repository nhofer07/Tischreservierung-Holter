# Die Paket-Erstellung trägt Version und Architektur automatisch ein.
DESKVISION_VERSION=1.0.0
DESKVISION_ARCH=amd64
DESKVISION_BIND_ADDRESS=127.0.0.1
DESKVISION_PORT=3000

# Öffentliche Kennungen der bisher im Projekt konfigurierten Entra-App.
# Bei einer eigenen Firmen-App beide Werte gemeinsam ändern.
ENTRA_TENANT_ID=14ddf41a-9afb-4810-bc22-227e34a9a007
ENTRA_CLIENT_ID=8fe2707e-b93a-4657-ad94-d0440a067b8b

# setup.js trägt die Microsoft-E-Mail des ersten Superadmins ein.
BOOTSTRAP_ADMIN_EMAIL=
