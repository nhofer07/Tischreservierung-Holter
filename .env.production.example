# Diese Datei als .env.production kopieren und ausschließlich auf dem Server ausfüllen.
MONGO_ROOT_USER=deskvision_root
MONGO_ROOT_PASSWORD=CHANGE_ME_WITH_A_LONG_RANDOM_VALUE
MONGO_APP_USER=deskvision_app
MONGO_APP_PASSWORD=CHANGE_ME_WITH_ANOTHER_LONG_RANDOM_VALUE

# Öffentliche Kennungen der Entra-App (keine Client-Secrets).
ENTRA_TENANT_ID=14ddf41a-9afb-4810-bc22-227e34a9a007
ENTRA_CLIENT_ID=8fe2707e-b93a-4657-ad94-d0440a067b8b

# Der Web-Port sollte in Produktion nur vom TLS-Reverse-Proxy erreichbar sein.
DESKVISION_HTTP_PORT=3000
